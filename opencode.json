{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/thinkingmachines/inkling:free",
  "autoupdate": false,
  "small_model": "openrouter/nvidia/nemotron-3.5-lightning:free",
  "instructions": [
    "GEMINI.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "experimental_image_generate": "deny",
    "external_directory": {
      "*": "deny",
      "C:\\dev\\game\\inbox\\*": "allow",
      "C:/dev/game/inbox/*": "allow"
    }
  },
  "provider": {
    "nvidia": {
      "models": {
        "deepseek-ai/deepseek-v4.1-flash": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "z-ai/glm-5.3-flash": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  }
}
