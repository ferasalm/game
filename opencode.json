{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/thinkingmachines/inkling:free",
  "autoupdate": false,
  "small_model": "openrouter/nvidia/nemotron-3.5-lightning:free",
  "instructions": [
    "GEMINI.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "experimental_image_generate": "deny",
    "external_directory": {
      "*": "deny",
      "C:\\dev\\game\\inbox\\*": "allow",
      "C:/dev/game/inbox/*": "allow"
    }
  },
  "provider": {
    "cloudflare-workers-ai": {
      "models": {
        "@cf/zai-org/glm-5.3": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "@cf/deepseek-ai/deepseek-v4.1-flash-1017": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "deepseek-v4.1-flash-low": {
          "id": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
          "name": "DeepSeek V4.1 Flash, low reasoning",
          "options": {
            "reasoning_effort": "low"
          },
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "deepseek-v4.1-flash-high": {
          "id": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
          "name": "DeepSeek V4.1 Flash, high reasoning",
          "options": {
            "reasoning_effort": "high"
          },
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "deepseek-v4.1-flash-fast": {
          "id": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
          "name": "DeepSeek V4.1 Flash, no reasoning",
          "options": {
            "reasoning_effort": "none"
          },
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        }
      }
    }
  }
}
