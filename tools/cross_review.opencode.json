{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "task": "deny",
    "execute": "deny",
    "websearch": "deny",
    "external_directory": {
      "*": "deny"
    }
  },
  "provider": {
    "nvidia": {
      "models": {
        "deepseek-ai/deepseek-v4.1-flash": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "z-ai/glm-5.3-flash": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  }
}
