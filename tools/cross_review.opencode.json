{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "task": "deny",
    "execute": "deny",
    "websearch": "deny",
    "external_directory": {
      "*": "deny"
    }
  },
  "provider": {
    "cloudflare-workers-ai": {
      "models": {
        "@cf/zai-org/glm-5.3": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "@cf/zai-org/glm-5.3-flash": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "@cf/deepseek-ai/deepseek-v4.1-flash-1017": {
          "options": {
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        }
      }
    }
  }
}
