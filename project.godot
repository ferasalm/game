; Engine configuration file (Godot 4.7). Edit with care: the editor rewrites it on save.

config_version=5

[application]

config/name="Qarnaw (working title)"
config/version="0.0.1"
run/main_scene="res://features/neon/neon_game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://core/event_bus.gd"
GameState="*res://core/game_state.gd"
ContentDB="*res://core/content_db.gd"
TextDB="*res://core/text_db.gd"
AudioDirector="*res://core/audio_director.gd"
Router="*res://core/scene_router.gd"
Screens="*res://features/ui/view/ui_stack.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0), Object(InputEventJoypadButton,"button_index":13)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":14)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0), Object(InputEventJoypadButton,"button_index":11)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":12)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":4194308), Object(InputEventJoypadButton,"button_index":1)]
}
menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":4194306), Object(InputEventJoypadButton,"button_index":6)]
}
playtest_capture={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194343), Object(InputEventJoypadButton,"button_index":4)]
}

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false

[shader_globals]

occ_cam={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
occ_target={
"type": "vec4",
"value": Vector4(0, 0, 0, 2.4)
}
occ_shape={
"type": "vec4",
"value": Vector4(1.4, 0.6, 0, 0)
}
