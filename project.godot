; Engine configuration file (Godot 4.7). Edit with care: the editor rewrites it on save.

config_version=5

[application]

config/name="Qarnaw (working title)"
config/version="0.0.1"
run/main_scene="res://features/world/look_test/look_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://core/event_bus.gd"
GameState="*res://core/game_state.gd"
ContentDB="*res://core/content_db.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
