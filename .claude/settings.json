{
  "permissions": {
    "deny": [
      "Read(**/.godot/**)",
      "Read(**/*.import)",
      "Read(**/*.uid)",
      "Read(**/inbox/retired/**)",
      "Read(**/gemini-blueprint-citations.md)",
      "Read(**/*.glb)",
      "Read(**/*.gltf)",
      "Read(**/*.blend)",
      "Read(**/*.fbx)",
      "Read(**/*.wav)",
      "Read(**/*.ogg)",
      "Read(**/*.mp3)",
      "Read(**/*.mp4)",
      "Read(**/*.webm)",
      "Read(**/*.ttf)",
      "Read(**/*.otf)",
      "Edit(**/*.import)",
      "Edit(**/*.uid)"
    ]
  },
  "skillOverrides": {
    "handoff": "name-only",
    "emergency-efficiency": "name-only",
    "ops-review": "name-only",
    "blender-addon-engineer": "name-only",
    "game-audio-engineer": "name-only",
    "game-designer": "name-only",
    "godot-gameplay-scripter": "name-only",
    "godot-shader-developer": "name-only",
    "level-designer": "name-only",
    "narrative-designer": "name-only",
    "technical-artist": "name-only",
    "ui-designer": "name-only",
    "ui-finish-gate-reviewer": "name-only",
    "market-player": "name-only",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:computer-use": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__(generate-image|generate-speech|rodin_generate.*|creative_(generate|edit)_.*|creative_design_voice|vidiq_(generate_.*|voiceover_generate|edit_media|motion_graphics)|run|generate_3d)$|runware",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/run.sh\" pre_spend --required"
          }
        ]
      },
      {
        "matcher": "^(SendUserFile|Artifact)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/run.sh\" review_gate"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"$CLAUDE_PROJECT_DIR/tools/statusline.py\""
  },
  "enabledPlugins": {
    "pm@neon": true,
    "studio@neon": true
  }
}
