# Godot cache and local files (the editor rebuilds .godot/); keep *.import and *.uid files in git.
/.godot/
/export/
/builds/
/.check/
*.tmp
__pycache__/
# Godot editor binaries (Windows, local only; tools/godot.sh finds them)
/Godot_v*_win64*.exe
# Claude Code agent worktrees (local only)
/.claude/worktrees/

# Owner drop folder for raw Gemini/Flow pictures (raw generations stay out of git: ARCHITECTURE 13)
/inbox/
/.bake/
# Hyper3D's RodinBridge editor plugin: Feras's local copy, no licence file (DECISIONS 2026-10-22)
/RodinBridge/
